<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HCEP.Core\HCEP.Core.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Spatial\HCEP.Spatial.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Knowledge\HCEP.Knowledge.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Intelligence\HCEP.Intelligence.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Vision\HCEP.Vision.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Telemetry\HCEP.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Kinect\HCEP.Kinect.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Audio\HCEP.Audio.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Speech\HCEP.Speech.csproj" />
    <ProjectReference Include="..\..\src\HCEP.Plugin.Api\HCEP.Plugin.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\HCEP.App\AvatarCatalog.cs" Link="App\AvatarCatalog.cs" />
    <Compile Include="..\..\src\HCEP.App\IAvatarComponent.cs" Link="App\IAvatarComponent.cs" />
    <Compile Include="..\..\src\HCEP.App\SvgAvatarControl.cs" Link="App\SvgAvatarControl.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO.Path" Alias="Path" />
    <Using Include="System.IO.File" Alias="File" />
  </ItemGroup>

</Project>
