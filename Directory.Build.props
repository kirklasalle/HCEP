<Project>
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HCEP</RootNamespace>
    <Company>Kirk LaSalle</Company>
    <Product>HCEP — Human Communication Eye Protocol</Product>
    <Copyright>Copyright © 2026 Kirk LaSalle. All rights reserved.</Copyright>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <InformationalVersion>1.6.0</InformationalVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress moderate NuGet audit warnings (e.g. ImageSharp) promoted by TreatWarningsAsErrors.
         Critical/high vulnerabilities still block the build. -->
    <WarningsNotAsErrors>NU1902</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
