# ── Build outputs ──────────────────────────────────
bin/
obj/
out/
publish/
artifacts/

# ── Archives & screenshots ─────────────────────────
*.zip
screengrab/
orbcamera/

# ── IDE / Editor ───────────────────────────────────
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# ── NuGet ──────────────────────────────────────────
*.nupkg
**/packages/
project.lock.json
project.fragment.lock.json

# ── Rider ──────────────────────────────────────────
.idea/
*.sln.iml

# ── OS Files ───────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ── Logs ───────────────────────────────────────────
logs/
*.log

# ── Model files (too large for git) ───────────────
