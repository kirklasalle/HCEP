<UserControl x:Class="HCEP.App.AvatarCoreControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTip="HCEP True Gaze Avatar — 2D Happy Face with live gaze-driven pupils">

    <!--
        Layout reference (all coordinates in local canvas space, origin top-left):
          Face circle centre  : (140, 140) — radius 120
          Left  eye centre    : ( 95, 112)
          Right eye centre    : (185, 112)
          Eye socket diameter :  44 px
          Pupil diameter      :  20 px  (max travel ±12 px inside socket)
          Smile arc           : M 78,172  A 62,42 0 0 1 202,172
    -->

    <Viewbox Stretch="Uniform">
        <Canvas x:Name="RootCanvas"
                Width="280"
                Height="280"
                Background="Transparent">

            <!-- ── Face ──────────────────────────────────────────── -->
            <Ellipse x:Name="FaceCircle"
                     Canvas.Left="20"
                     Canvas.Top="20"
                     Width="240"
                     Height="240"
                     Fill="#FFFFD700"
                     Stroke="#FFCC9900"
                     StrokeThickness="3"
                     ToolTip="Avatar face — yellow circle representing the avatar head"/>

            <!-- ── Left Eye Socket ───────────────────────────────── -->
            <!-- 3D eye sphere rendered by EyeSphereVisual in code-behind -->
            <!-- Invisible hit-test placeholder keeps screen-coordinate tracking working -->
            <Canvas x:Name="LeftEyeHost"
                    Canvas.Left="73"
                    Canvas.Top="90"
                    Width="44"
                    Height="44"
                    Background="Transparent"
                    ToolTip="Left eye socket — 3D sphere rendered in code-behind"/>

            <!-- ── Right Eye Socket ──────────────────────────────── -->
            <Canvas x:Name="RightEyeHost"
                    Canvas.Left="163"
                    Canvas.Top="90"
                    Width="44"
                    Height="44"
                    Background="Transparent"
                    ToolTip="Right eye socket — 3D sphere rendered in code-behind"/>

            <!-- ── Eyelids (animated in code-behind) ───────────────────── -->
            <!-- Left eye lids -->
            <Rectangle x:Name="LeftUpperLid"
                       Canvas.Left="73"
                       Canvas.Top="90"
                       Width="44"
                       Height="0"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#FFFFD700"
                       Stroke="#FFCC9900"
                       StrokeThickness="1"/>
            <Rectangle x:Name="LeftLowerLid"
                       Canvas.Left="73"
                       Canvas.Top="134"
                       Width="44"
                       Height="0"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#FFFFD700"
                       Stroke="#FFCC9900"
                       StrokeThickness="1"/>

            <!-- Right eye lids -->
            <Rectangle x:Name="RightUpperLid"
                       Canvas.Left="163"
                       Canvas.Top="90"
                       Width="44"
                       Height="0"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#FFFFD700"
                       Stroke="#FFCC9900"
                       StrokeThickness="1"/>
            <Rectangle x:Name="RightLowerLid"
                       Canvas.Left="163"
                       Canvas.Top="134"
                       Width="44"
                       Height="0"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#FFFFD700"
                       Stroke="#FFCC9900"
                       StrokeThickness="1"/>

            <!-- ── Smile ─────────────────────────────────────────── -->
            <!--
            Arc from (78,172) to (202,172), rx=62, ry=42, sweep=1 (clockwise → curves down).
            StrokeThickness 5 gives a bold, readable smile at avatar viewing distances.
        -->
            <Path Stroke="#FF1A1A1A"
                  StrokeThickness="5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  ToolTip="Smile — drawn as a WPF ArcSegment, no external assets required"
                  Data="M 78,172 A 62,42 0 0 0 202,172"/>

        </Canvas>
    </Viewbox>
</UserControl>
