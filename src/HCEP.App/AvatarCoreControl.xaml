<UserControl x:Class="HCEP.App.AvatarCoreControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTip="HCEP True Gaze Avatar — 2D Happy Face with live gaze-driven pupils">

    <!--
        Layout reference (all coordinates in local canvas space, origin top-left):
          Face circle centre  : (140, 140) — radius 120
          Left  eye centre    : ( 95, 112)
          Right eye centre    : (185, 112)
          Eye socket diameter :  44 px
          Pupil diameter      :  20 px  (max travel ±12 px inside socket)
          Smile arc           : M 78,172  A 62,42 0 0 1 202,172
    -->

    <Viewbox Stretch="Uniform">
        <Canvas x:Name="RootCanvas"
                Width="280"
                Height="280"
                Background="Transparent">

            <!-- ── Face ──────────────────────────────────────────── -->
            <Ellipse x:Name="FaceCircle"
                     Canvas.Left="20"
                     Canvas.Top="20"
                     Width="240"
                     Height="240"
                     Fill="#FFFFD700"
                     Stroke="#FFCC9900"
                     StrokeThickness="3"
                     ToolTip="Avatar face — yellow circle representing the avatar head"/>

            <!-- ── Left Eye Socket ───────────────────────────────── -->
            <!-- 3D eye sphere rendered by EyeSphereVisual in code-behind -->
            <!-- Invisible hit-test placeholder keeps screen-coordinate tracking working -->
            <Canvas x:Name="LeftEyeHost"
                    Canvas.Left="73"
                    Canvas.Top="90"
                    Width="44"
                    Height="44"
                    Background="Transparent"
                    ToolTip="Left eye socket — 3D sphere rendered in code-behind"/>

            <!-- ── Right Eye Socket ──────────────────────────────── -->
            <Canvas x:Name="RightEyeHost"
                    Canvas.Left="163"
                    Canvas.Top="90"
                    Width="44"
                    Height="44"
                    Background="Transparent"
                    ToolTip="Right eye socket — 3D sphere rendered in code-behind"/>

            <!-- ── Eyelids (animated in code-behind) ───────────────────── -->
            <!-- Left eye lids -->
            <Rectangle x:Name="LeftUpperLid"
                       Canvas.Left="73"
                       Canvas.Top="90"
                       Width="44"
                       Height="0"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#FFFFD700"
                       Stroke="#FFCC9900"
                       StrokeThickness="1"/>
            <Rectangle x:Name="LeftLowerLid"
                       Canvas.Left="73"
                       Canvas.Top="134"
                       Width="44"
                       Height="0"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#FFFFD700"
                       Stroke="#FFCC9900"
                       StrokeThickness="1"/>

            <!-- Right eye lids -->
            <Rectangle x:Name="RightUpperLid"
                       Canvas.Left="163"
                       Canvas.Top="90"
                       Width="44"
                       Height="0"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#FFFFD700"
                       Stroke="#FFCC9900"
                       StrokeThickness="1"/>
            <Rectangle x:Name="RightLowerLid"
                       Canvas.Left="163"
                       Canvas.Top="134"
                       Width="44"
                       Height="0"
                       RadiusX="22"
                       RadiusY="22"
                       Fill="#FFFFD700"
                       Stroke="#FFCC9900"
                       StrokeThickness="1"/>

            <!-- ── Left Eyebrow ────────────────────────────────────── -->
            <!--
                Quadratic bezier: M outer  Q peak  inner
                Neutral: outer=(66,80)  peak=(95,68)  inner=(120,76)
                Animated in code-behind via AU1/AU2 (raise) and AU4 (furrow).
                Canvas.Left/Top set to (0,0) — coordinates are absolute in
                canvas space, same as all other face elements.
            -->
            <Path x:Name="LeftBrow"
                  Stroke="#FF1A1A1A"
                  StrokeThickness="5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Fill="Transparent"
                  ToolTip="Left eyebrow — animated via AU1 inner brow raise, AU2 outer brow raise, AU4 brow lowerer"
                  Data="M 66,80 Q 95,68 120,76"/>

            <!-- ── Right Eyebrow ───────────────────────────────────── -->
            <Path x:Name="RightBrow"
                  Stroke="#FF1A1A1A"
                  StrokeThickness="5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Fill="Transparent"
                  ToolTip="Right eyebrow — animated via AU1 inner brow raise, AU2 outer brow raise, AU4 brow lowerer"
                  Data="M 160,76 Q 185,68 214,80"/>

            <!-- ── Smile / Mouth (animated in code-behind for lip sync) ── -->
            <!--
            Arc from (78,172) to (202,172), rx=62, ry=42, sweep=0 (anticlockwise → curves up = smile).
            Data is overridden at runtime by ApplyViseme() for lip-sync mouth shapes.
            MouthFill shows an open-mouth dark area when JawOpen > 0.
        -->
            <Ellipse x:Name="MouthFill"
                     Canvas.Left="89"
                     Canvas.Top="172"
                     Width="102"
                     Height="0"
                     Fill="#FF1A1A1A"
                     Opacity="0"
                     ToolTip="Open mouth area — shown during speech visemes with JawOpen > 0"/>

            <Path x:Name="SmilePath"
                  Stroke="#FF1A1A1A"
                  StrokeThickness="5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  ToolTip="Smile / mouth — animated by ApplyViseme() for lip-sync during speech"
                  Data="M 78,172 A 62,42 0 0 0 202,172"/>

        </Canvas>
    </Viewbox>
</UserControl>
