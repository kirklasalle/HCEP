<Window x:Class="HCEP.App.AvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HCEP.App"
        Title="HCEP — True Gaze Avatar"
        Background="#FF0A0A0A"
        Width="340"
        Height="340"
        MinWidth="220"
        MinHeight="220"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="True"
        ToolTip="HCEP True Gaze Avatar — pupils track the physical user in real time">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Avatar UserControl ──────────────────────────── -->
        <local:AvatarCoreControl x:Name="Avatar"
                                 Grid.Row="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

        <!-- ── Telemetry HUD ──────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#DD0D0D0D"
                Padding="8,5"
                ToolTip="Live gaze telemetry — TrackingMode, Distance, Pitch, Yaw">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TrackingMode -->
                <StackPanel Grid.Column="0"
                        Orientation="Vertical">
                    <TextBlock Text="MODE"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TrackingModeText"
                               Text="—"
                               Foreground="#FFAAFFAA"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Distance -->
                <StackPanel Grid.Column="1"
                        Orientation="Vertical">
                    <TextBlock Text="DIST"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DistanceText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Pitch -->
                <StackPanel Grid.Column="2"
                        Orientation="Vertical">
                    <TextBlock Text="PITCH"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PitchText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Yaw -->
                <StackPanel Grid.Column="3"
                        Orientation="Vertical">
                    <TextBlock Text="YAW"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="YawText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
