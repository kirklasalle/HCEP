<Window x:Class="HCEP.App.AvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HCEP.App"
        Title="HCEP — True Gaze Avatar"
        Background="#FF0A0A0A"
        Width="340"
        Height="340"
        MinWidth="220"
        MinHeight="220"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="True"
        ToolTip="HCEP True Gaze Avatar — pupils track the physical user in real time">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Avatar area: 2D Happy Face or 3D Wireframe ────── -->
        <Grid Grid.Row="0">
            <local:AvatarCoreControl x:Name="Avatar"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
            <!-- 3D wireframe control — Collapsed until user switches mode -->
            <local:Avatar3DControl x:Name="Avatar3D"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Margin="8"/>
        </Grid>

        <!-- ── Telemetry HUD ──────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#DD0D0D0D"
                Padding="8,5"
                ToolTip="Live gaze telemetry — TrackingMode, Distance, Pitch, Yaw">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TrackingMode -->
                <StackPanel Grid.Column="0"
                            Orientation="Vertical">
                    <TextBlock Text="MODE"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TrackingModeText"
                               Text="—"
                               Foreground="#FFAAFFAA"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Distance -->
                <StackPanel Grid.Column="1"
                            Orientation="Vertical">
                    <TextBlock Text="DIST"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DistanceText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Pitch -->
                <StackPanel Grid.Column="2"
                            Orientation="Vertical">
                    <TextBlock Text="PITCH"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PitchText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Yaw -->
                <StackPanel Grid.Column="3"
                            Orientation="Vertical">
                    <TextBlock Text="YAW"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="YawText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Mesh status (vertex count or FP fallback) -->
                <StackPanel Grid.Column="4"
                            Orientation="Vertical"
                            ToolTip="MESH: real Candide-3 triangle count, or FP=87-point fallback">
                    <TextBlock Text="MESH"
                               Foreground="#44FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MeshStatusText"
                               Text="—"
                               Foreground="#FFFF9940"
                               FontFamily="Segoe Mono,Consolas"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Avatar mode selector (2D / 3D) -->
                <ComboBox Grid.Column="5"
                          x:Name="AvatarModeCombo"
                          SelectionChanged="AvatarMode_SelectionChanged"
                          Margin="6,2,2,2"
                          Padding="4,2"
                          MinWidth="80"
                          BorderBrush="#44FFFFFF"
                          BorderThickness="1"
                          FontFamily="Segoe UI"
                          FontSize="10"
                          Cursor="Hand"
                          ToolTip="Switch between 2D Happy Face and 3D Wireframe avatar">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter Property="Padding"
                                    Value="6,3"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Content="2D Happy"/>
                    <ComboBoxItem Content="3D Wireframe"/>
                </ComboBox>

            </Grid>
        </Border>

    </Grid>
</Window>

