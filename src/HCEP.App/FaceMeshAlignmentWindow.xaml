<Window x:Class="HCEP.App.FaceMeshAlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HCEP — Face Mesh Alignment"
        Width="520"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="CanResize"
        MinWidth="460"
        MinHeight="420"
        ToolTip="Live-adjust the vertical and horizontal offset applied to every overlay so the face mesh lines up with the real face on the color feed.">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="◐ Face Mesh Alignment"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextDimBrush}"
                   Margin="0,0,0,14"
                   Text="Watch the main window's sensor feed while dragging the sliders below. The overlay updates in real time. If the mesh sits low on your face (top of mesh at nose tip), reduce the vertical offset until the mesh top lines up with your forehead."/>

        <!-- Vertical offset -->
        <Grid Grid.Row="2"
              Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Vertical offset (px)"
                       VerticalAlignment="Center"/>
            <Slider x:Name="VerticalSlider"
                    Grid.Column="1"
                    Minimum="-120"
                    Maximum="120"
                    TickFrequency="10"
                    IsSnapToTickEnabled="False"
                    Value="48"
                    ValueChanged="OnVerticalChanged"
                    ToolTip="Vertical shift applied to overlay pixels. Increase → shift down. Decrease → shift up."/>
            <TextBlock x:Name="VerticalReadout"
                       Grid.Column="2"
                       Text="48.0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas"/>
        </Grid>

        <!-- Horizontal offset -->
        <Grid Grid.Row="3"
              Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Horizontal offset (px)"
                       VerticalAlignment="Center"/>
            <Slider x:Name="HorizontalSlider"
                    Grid.Column="1"
                    Minimum="-80"
                    Maximum="80"
                    TickFrequency="5"
                    Value="0"
                    ValueChanged="OnHorizontalChanged"
                    ToolTip="Horizontal shift applied to overlay pixels. Increase → shift right. Decrease → shift left."/>
            <TextBlock x:Name="HorizontalReadout"
                       Grid.Column="2"
                       Text="0.0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas"/>
        </Grid>

        <!-- Mesh scale -->
        <Grid Grid.Row="4"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Mesh scale (relative)"
                       VerticalAlignment="Center"
                       ToolTip="Not yet applied to the video overlay renderer — reserved for a future release."/>
            <Slider x:Name="ScaleSlider"
                    Grid.Column="1"
                    Minimum="0.6"
                    Maximum="1.6"
                    TickFrequency="0.05"
                    Value="1.0"
                    ValueChanged="OnScaleChanged"/>
            <TextBlock x:Name="ScaleReadout"
                       Grid.Column="2"
                       Text="1.00"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas"/>
        </Grid>

        <Border Grid.Row="5"
                Background="#22FFFFFF"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Alignment protocol"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="11"
                           Margin="0,3,0,0"
                           Text="1) Face the sensor at your normal working distance.  2) Watch the yellow face bounding box and cyan mesh in the main window.  3) Adjust vertical offset until the mesh top aligns with your forehead.  4) Adjust horizontal offset if the mesh sits left or right of your face.  5) Click Save to persist across restarts."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,12">
            <Button Content="Reset Defaults"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="ResetButton_Click"
                    ToolTip="Restore the compiled Kinect v1 depth-to-color defaults (Y = 48 px, X = 0 px, Scale = 1.0)."/>
            <Button x:Name="SaveButton"
                    Content="Save"
                    Padding="14,4"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    ToolTip="Persist the current values to %LocalAppData%\HCEP\overlay-alignment.json"/>
            <Button Content="Close"
                    Padding="12,4"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="7"
                   x:Name="SaveStatus"
                   Foreground="{StaticResource PrimaryBrush}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Right"/>
    </Grid>
</Window>
