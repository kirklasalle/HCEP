<Window x:Class="HCEP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HCEP.App"
        mc:Ignorable="d"
        Title="HCEP — Human Communication Eye Protocol"
        Height="900"
        Width="1440"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ToolTipService.ShowDuration="10000"
        ToolTipService.InitialShowDelay="350">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0"
              ToolTip="Main application menu">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings"
                          Command="{Binding OpenSettingsCommand}"
                          ToolTip="Configure HCEP local and cloud AI options"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="_Exit"
                          Command="{Binding ExitApplicationCommand}"
                          ToolTip="Close the HCEP application and all child windows"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Sensor Streams"
                          Command="{Binding OpenSensorViewCommand}"
                          ToolTip="Open the Kinect Sensor Streams window showing RGB, IR, and Depth side-by-side"/>
                <MenuItem Header="_Kinect Video"
                          Command="{Binding OpenKinectVideoCommand}"
                          ToolTip="Open the dedicated Kinect RGB video feed window"/>
            </MenuItem>
            <MenuItem Header="_Kinect">
                <MenuItem Header="Tilt _Up (+2°)"
                          Command="{Binding ElevationUpCommand}"
                          ToolTip="Tilt the Kinect sensor motor up by 2 degrees (range: -27° to +27°)"/>
                <MenuItem Header="Tilt _Down (-2°)"
                          Command="{Binding ElevationDownCommand}"
                          ToolTip="Tilt the Kinect sensor motor down by 2 degrees (range: -27° to +27°)"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Skeleton Tracking"
                          IsCheckable="True"
                          IsChecked="{Binding SkeletonTrackingEnabled}"
                          ToolTip="Enable or disable skeleton body tracking from the depth sensor"/>
                <MenuItem Header="Face Tracking"
                          IsCheckable="True"
                          IsChecked="{Binding FaceTrackingEnabled}"
                          ToolTip="Enable or disable real-time face tracking via FaceTrackLib.dll"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Color Stream"
                          IsCheckable="True"
                          IsChecked="{Binding ColorStreamEnabled}"
                          ToolTip="Enable or disable the RGB color video stream from the Kinect camera"/>
                <MenuItem Header="Depth Stream"
                          IsCheckable="True"
                          IsChecked="{Binding DepthStreamEnabled}"
                          ToolTip="Enable or disable the depth + IR streams from the Kinect sensor"/>
            </MenuItem>
            <MenuItem Header="_Avatar">
                <MenuItem Header="_Calibration">
                    <MenuItem Header="_Gaze Calibration"
                              Command="{Binding OpenCalibrationCommand}"
                              ToolTip="Open the full-screen gaze calibration overlay to compute the Kinect-to-screen offset"/>
                    <MenuItem Header="_Face Mesh Alignment…"
                              Command="{Binding OpenFaceMeshAlignmentCommand}"
                              ToolTip="Live-adjust the vertical/horizontal offset applied to overlay pixels so the face mesh lines up with the real face"/>
                    <MenuItem Header="_Skeletal Alignment…"
                              Command="{Binding OpenSkeletalAlignmentCommand}"
                              ToolTip="Live-adjust the skeleton overlay independently from the face mesh overlay"/>
                    <MenuItem Header="_PnP Head Pose…"
                              Command="{Binding OpenPnPCalibrationCommand}"
                              ToolTip="Visualise the Perspective-n-Point head-pose solve — reprojection residuals, pose axes, and live pitch/yaw/roll"/>
                </MenuItem>
                <MenuItem Header="_Show Avatar"
                          Command="{Binding OpenAvatarWindowCommand}"
                          ToolTip="Open the True Gaze Avatar window — Happy Face with live pupil gaze tracking"/>
                <Separator/>
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Mode: "
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#CCFFFFFF"/>
                            <ComboBox Width="110"
                                      SelectedValue="{Binding CurrentAvatarMode, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      FontSize="11"
                                      ToolTip="Switch avatar between 2D Happy Face and 3D Wireframe">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                                        <Setter Property="Padding"
                                                Value="6,3"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="2D Happy"/>
                                <ComboBoxItem Content="3D Wireframe"/>
                            </ComboBox>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Check for Updates…"
                          Command="{Binding CheckForUpdatesCommand}"
                          ToolTip="Query the HCEP GitHub releases feed for a newer version — configuration is never overwritten"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="_About HCEP"
                          Command="{Binding ShowAboutCommand}"
                          ToolTip="Information about HCEP — Human Communication Eye Protocol"/>
            </MenuItem>
        </Menu>

        <!-- Header -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8"
                Padding="16,10"
                Margin="12,4,12,8"
                ToolTip="HCEP application header — shows brand, status, and window launchers">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="◉ HCEP"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center"
                           ToolTip="Human Communication Eye Protocol — real-time gaze and cognitive state analysis"/>

                <TextBlock Grid.Column="1"
                           Text="Human Communication Eye Protocol"
                           FontSize="13"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           ToolTip="Full application title"/>
                <!-- Window Launch Buttons -->
                <Button Grid.Column="2"
                        Content="◎ Sensor Streams"
                        Command="{Binding OpenSensorViewCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        Padding="12,4"
                        Margin="0,0,8,0"
                        FontSize="11"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Open the Kinect Sensor Streams window showing RGB, IR, and Depth views side-by-side"/>
                <Button Grid.Column="3"
                        Content="⬆ Check for Updates"
                        Command="{Binding CheckForUpdatesCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        Padding="12,4"
                        Margin="0,0,12,0"
                        FontSize="11"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Check for and stage new HCEP releases. User settings, credentials, and logs are preserved by design."/>
                <Button Grid.Column="4"
                        Content="▶ Kinect Video"
                        Command="{Binding OpenKinectVideoCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        Padding="12,4"
                        Margin="0,0,12,0"
                        FontSize="11"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Open the dedicated Kinect RGB video feed window with FPS counter"/>

                <Button Grid.Column="5"
                        Content="⚙ Settings"
                        Command="{Binding OpenSettingsCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        Padding="12,4"
                        Margin="0,0,12,0"
                        FontSize="11"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Configure local/cloud AI models and oculo-postural mirroring settings"/>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            ToolTip="Toggle full body skeleton tracking on/off — when off, only upper body is drawn. When on, legs are drawn if standing.">
                    <ToggleButton IsChecked="{Binding ShowFullSkeleton}"
                                  Padding="8,3"
                                  FontSize="10"
                                  Cursor="Hand"
                                  Background="{StaticResource SurfaceBrush}"
                                  Foreground="{StaticResource AccentBrush}"
                                  BorderBrush="{StaticResource AccentBrush}"
                                  BorderThickness="1">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content"
                                        Value="☐ Full Body"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter Property="Content"
                                                Value="☑ Full Body"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>

                <!-- Face Enrollment -->
                <StackPanel Grid.Column="7"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            ToolTip="Enroll a new face identity — type a name and press Enroll while facing the camera">
                    <TextBox Text="{Binding EnrollmentName, UpdateSourceTrigger=PropertyChanged}"
                             Width="90"
                             VerticalAlignment="Center"
                             FontSize="10"
                             Padding="4,2"
                             Background="#22FFFFFF"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource AccentBrush}"
                             BorderThickness="1"
                             ToolTip="Enter the name of the person to enroll"/>
                    <Button Content="Enroll"
                            Command="{Binding EnrollFaceCommand}"
                            Padding="6,2"
                            Margin="4,0,0,0"
                            FontSize="10"
                            Cursor="Hand"
                            Background="{StaticResource SurfaceBrush}"
                            Foreground="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            ToolTip="Enroll the currently tracked face under the entered name"/>
                    <TextBlock Text="{Binding RecognizedIdentity}"
                               FontSize="10"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               ToolTip="Currently recognized face identity"/>
                </StackPanel>

                <StackPanel Grid.Column="8"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            ToolTip="Kinect sensor connection status indicator">
                    <Ellipse Width="10"
                             Height="10"
                             Margin="0,0,6,0"
                             Fill="{Binding SensorStatusBrush}"
                             ToolTip="Green = connected and streaming, Red = disconnected or error"/>
                    <TextBlock Text="{Binding SensorStatus}"
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               ToolTip="Current Kinect sensor connection state"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content (3-column: Video | Sensor+State | Metrics+Chat) -->
        <Grid Grid.Row="2"
              Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"
                                  MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.4*"
                                  MinWidth="340"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.7*"
                                  MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Video Feed (full height) -->
            <Border Grid.Column="0"
                    Background="#1E1E2E"
                    CornerRadius="8"
                    ClipToBounds="True"
                    ToolTip="Live RGB video feed from the Kinect v1 camera sensor — 640×480 @ 30fps with skeleton, face box, and wireframe overlays">
                <Grid>
                    <Image Source="{Binding VideoFrame}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <local:VideoOverlayControl
                        Snapshot="{Binding LatestSnapshot}"
                        ShowFullSkeleton="{Binding ShowFullSkeleton}"
                        IsHitTestVisible="False"/>
                    <TextBlock Text="SENSOR FEED"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDimBrush}"
                               Margin="10,8"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"/>
                </Grid>
            </Border>

            <!-- GridSplitter: Video | Center -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#30FFFFFF"
                          Cursor="SizeWE"
                          ShowsPreview="True">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Ellipse Width="3"
                                         Height="3"
                                         Fill="#60FFFFFF"
                                         Margin="0,1.5"/>
                                <Ellipse Width="3"
                                         Height="3"
                                         Fill="#60FFFFFF"
                                         Margin="0,1.5"/>
                                <Ellipse Width="3"
                                         Height="3"
                                         Fill="#60FFFFFF"
                                         Margin="0,1.5"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Center: HCEP State + Sensor View -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"
                                   MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"
                                   MinHeight="80"/>
                </Grid.RowDefinitions>

                <!-- Compact Mode Display -->
                <Border Grid.Row="0"
                        Background="#1A7C3AED"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="HCEP MODE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding CurrentMode}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding Confidence}"
                                     Maximum="1"
                                     Height="4"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#333"
                                     Margin="16,0"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding ConfidencePercent, StringFormat={}{0:F0}%}"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- State Grid -->
                <UniformGrid Grid.Row="1"
                             Columns="3"
                             Margin="0,0,0,8">
                    <!-- Gaze Region -->
                    <Border Background="#15FFFFFF"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,4,0"
                            ToolTip="Current gaze region — where the tracked person is looking (e.g., Screen, Face, Away)">
                        <StackPanel>
                            <TextBlock Text="GAZE"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="{Binding GazeRegion}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Cognitive State -->
                    <Border Background="#15FFFFFF"
                            CornerRadius="4"
                            Padding="10"
                            Margin="2,0,2,0"
                            ToolTip="Detected cognitive state — inferred from eye movement patterns (e.g., Focused, Scanning, Thinking)">
                        <StackPanel>
                            <TextBlock Text="COGNITIVE"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="{Binding CognitiveState}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Valence -->
                    <Border Background="#15FFFFFF"
                            CornerRadius="4"
                            Padding="10"
                            Margin="4,0,0,0"
                            ToolTip="Emotional valence — positive/negative/neutral emotional tone detected from facial action units">
                        <StackPanel>
                            <TextBlock Text="VALENCE"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="{Binding Valence}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Gaze / Sensor Visualization -->
                <Border Grid.Row="2"
                        ClipToBounds="True"
                        Background="Transparent">
                    <local:GazeVisualizationControl
                        Snapshot="{Binding LatestSnapshot}"
                        ToolTip="Real-time gaze direction visualization — shows where the tracked person is looking on screen"/>
                </Border>
                <!-- GridSplitter: Gaze | Speech -->
                <GridSplitter Grid.Row="3"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="#30FFFFFF"
                              Cursor="SizeNS"
                              ResizeDirection="Rows"
                              ShowsPreview="True">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="2">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Ellipse Width="3"
                                             Height="3"
                                             Fill="#60FFFFFF"
                                             Margin="1.5,0"/>
                                    <Ellipse Width="3"
                                             Height="3"
                                             Fill="#60FFFFFF"
                                             Margin="1.5,0"/>
                                    <Ellipse Width="3"
                                             Height="3"
                                             Fill="#60FFFFFF"
                                             Margin="1.5,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Speech Log -->
                <Border Grid.Row="4"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="10"
                        ToolTip="Real-time speech recognition log — shows transcribed speech from the Kinect microphone array">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SPEECH LOG"
                                   FontSize="10"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,0,0,6"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SpeechLog}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- GridSplitter: Center | Right -->
            <GridSplitter Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#30FFFFFF"
                          Cursor="SizeWE"
                          ShowsPreview="True">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Ellipse Width="3"
                                         Height="3"
                                         Fill="#60FFFFFF"
                                         Margin="0,1.5"/>
                                <Ellipse Width="3"
                                         Height="3"
                                         Fill="#60FFFFFF"
                                         Margin="0,1.5"/>
                                <Ellipse Width="3"
                                         Height="3"
                                         Fill="#60FFFFFF"
                                         Margin="0,1.5"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Right: Metrics & LLM Panel -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"
                                   MinHeight="100"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Metrics -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,8"
                        ToolTip="Real-time pipeline performance metrics — FPS, vision latency, tracked persons, audio beam angle">
                    <StackPanel>
                        <TextBlock Text="PIPELINE METRICS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,2"
                              ToolTip="Frames per second — HCEP snapshot processing throughput">
                            <TextBlock Text="FPS"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="11"/>
                            <TextBlock Text="{Binding Fps, StringFormat=F1}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,2"
                              ToolTip="Vision pipeline latency in milliseconds per frame">
                            <TextBlock Text="Vision (ms)"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="11"/>
                            <TextBlock Text="{Binding VisionLatencyMs, StringFormat=F1}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2"
                              ToolTip="Number of persons currently tracked by skeleton tracking">
                            <TextBlock Text="Persons"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="11"/>
                            <TextBlock Text="{Binding TrackedPersons}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2"
                              ToolTip="Kinect microphone array beam angle — direction of primary audio source">
                            <TextBlock Text="Beam Angle"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="11"/>
                            <TextBlock Text="{Binding BeamAngle, StringFormat={}{0:F0}°}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"/>
                        </Grid>

                        <!-- ── Eye Location Telemetry (PRIMARY) ── -->
                        <Border Margin="0,6,0,0"
                                BorderBrush="#4000D0FF"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="4">
                            <StackPanel>
                                <TextBlock Text="👁 EYE LOCATIONS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#00C8FF"
                                           Margin="0,0,0,4"/>
                                <Grid Margin="0,1"
                                      ToolTip="Left eye 3D position in camera space (X, Y, Z) meters">
                                    <TextBlock Text="Left Eye"
                                               Foreground="#00C8FF"
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding LeftEyePosition}"
                                               HorizontalAlignment="Right"
                                               Foreground="#00C8FF"
                                               FontSize="10"
                                               FontFamily="Consolas"/>
                                </Grid>
                                <Grid Margin="0,1"
                                      ToolTip="Right eye 3D position in camera space (X, Y, Z) meters">
                                    <TextBlock Text="Right Eye"
                                               Foreground="#00C8FF"
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding RightEyePosition}"
                                               HorizontalAlignment="Right"
                                               Foreground="#00C8FF"
                                               FontSize="10"
                                               FontFamily="Consolas"/>
                                </Grid>
                                <Grid Margin="0,1"
                                      ToolTip="Inter-ocular distance — distance between eye centers (avg adult ~63mm)">
                                    <TextBlock Text="IOD"
                                               Foreground="{StaticResource TextDimBrush}"
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding InterOcularDistance}"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="10"
                                               FontFamily="Consolas"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- GridSplitter: Metrics | LLM -->
                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="#30FFFFFF"
                              Cursor="SizeNS"
                              ResizeDirection="Rows"
                              ShowsPreview="True">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="2">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Ellipse Width="3"
                                             Height="3"
                                             Fill="#60FFFFFF"
                                             Margin="1.5,0"/>
                                    <Ellipse Width="3"
                                             Height="3"
                                             Fill="#60FFFFFF"
                                             Margin="1.5,0"/>
                                    <Ellipse Width="3"
                                             Height="3"
                                             Fill="#60FFFFFF"
                                             Margin="1.5,0"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- LLM Chat -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="16"
                        ToolTip="LLM Assistant — chat with the AI using HCEP context from the current session">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: title · message count · Clear -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="LLM ASSISTANT"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDimBrush}"/>

                            <Border Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="6,1"
                                    CornerRadius="8"
                                    Background="#22FFFFFF"
                                    VerticalAlignment="Center"
                                    ToolTip="Number of messages in the current chat history">
                                <TextBlock Text="{Binding ChatLog.Count, FallbackValue=0}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </Border>

                            <Button Grid.Column="3"
                                    Content="Clear"
                                    Command="{Binding ClearChatCommand}"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextDimBrush}"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Padding="8,2"
                                    FontSize="10"
                                    Cursor="Hand"
                                    ToolTip="Clear the chat history (does not affect saved logs)"/>
                        </Grid>

                        <!-- Telemetry-window slider -->
                        <Border Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="10,8"
                                CornerRadius="6"
                                Background="#18FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                ToolTip="Choose how much recent telemetry history the LLM receives: Snapshot only, or a bounded rolling window up to 5 seconds.">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="Telemetry Window"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="Snapshot → 5s trend context"
                                               FontSize="10"
                                               Foreground="#7094A3B8"/>
                                </StackPanel>

                                <Slider Grid.Row="0"
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="5"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding ChatTelemetryWindowSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        ToolTip="0 = only the latest telemetry snapshot. 5 = a bounded rolling 5-second summary plus sampled timeline."/>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            ToolTip="How densely to sample the recent telemetry timeline inside the prompt.">
                                    <TextBlock Text="Density"
                                               FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Slider Width="84"
                                            Minimum="1"
                                            Maximum="3"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding ChatTelemetryDensityLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center"
                                            ToolTip="Sparse = fewer timeline anchors, Dense = more timeline anchors."/>
                                </StackPanel>

                                <Border Grid.Row="0"
                                        Grid.Column="3"
                                        Margin="12,0,0,0"
                                        Padding="8,2"
                                        CornerRadius="8"
                                        Background="#22FFFFFF"
                                        VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ChatTelemetryWindowLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding ChatTelemetryDensityLabel}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="4"
                                           Margin="0,8,0,0"
                                           Text="{Binding ChatPromptBudgetEstimateText}"
                                           FontSize="10"
                                           Foreground="#8FB0C8"
                                           TextWrapping="Wrap"
                                           ToolTip="Approximate token budget for the next request based on the full prompt preview and current input."/>
                            </Grid>
                        </Border>

                        <Expander Grid.Row="2"
                                  Margin="0,0,0,10"
                                  Header="Prompt Telemetry Debug"
                                  IsExpanded="{Binding ChatTelemetryDebugExpanded, Mode=TwoWay}"
                                  Foreground="{StaticResource TextDimBrush}"
                                  Background="Transparent"
                                  ToolTip="Inspect the exact telemetry block injected into the next chat prompt.">
                            <Border Margin="0,6,0,0"
                                    Padding="10"
                                    CornerRadius="6"
                                    Background="#141A26"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0"
                                            Content="Copy"
                                            Command="{Binding CopyTelemetryPromptCommand}"
                                            HorizontalAlignment="Right"
                                            Padding="10,3"
                                            Margin="0,0,0,8"
                                            FontSize="10"
                                            Cursor="Hand"
                                            ToolTip="Copy the telemetry-only prompt block to the clipboard."/>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding LastInjectedTelemetryText}"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextBrush}"
                                             BorderThickness="0"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinLines="6"
                                             MaxLines="14"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             ToolTip="This is the telemetry section the LLM receives from the chat harness."/>
                                </Grid>
                            </Border>
                        </Expander>

                        <Expander Grid.Row="3"
                                  Margin="0,0,0,10"
                                  Header="Full System Prompt Debug"
                                  IsExpanded="{Binding ChatSystemPromptDebugExpanded, Mode=TwoWay}"
                                  Foreground="{StaticResource TextDimBrush}"
                                  Background="Transparent"
                                  ToolTip="Inspect the entire system prompt, including PAD, personality harness, telemetry, and context layers.">
                            <Border Margin="0,6,0,0"
                                    Padding="10"
                                    CornerRadius="6"
                                    Background="#11151D"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0"
                                            Content="Copy"
                                            Command="{Binding CopySystemPromptCommand}"
                                            HorizontalAlignment="Right"
                                            Padding="10,3"
                                            Margin="0,0,0,8"
                                            FontSize="10"
                                            Cursor="Hand"
                                            ToolTip="Copy the full system prompt to the clipboard."/>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding LastInjectedSystemPromptText}"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextBrush}"
                                             BorderThickness="0"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinLines="8"
                                             MaxLines="18"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             ToolTip="This is the full system prompt used for the last chat send."/>
                                </Grid>
                            </Border>
                        </Expander>

                        <!-- Chat message list (bubbles) -->
                        <Grid Grid.Row="4">
                            <ListBox x:Name="ChatListBox"
                                     ItemsSource="{Binding ChatLog}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}"
                                     FontSize="12"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background"
                                                Value="Transparent"/>
                                        <Setter Property="Padding"
                                                Value="0"/>
                                        <Setter Property="Margin"
                                                Value="0"/>
                                        <Setter Property="BorderThickness"
                                                Value="0"/>
                                        <Setter Property="HorizontalContentAlignment"
                                                Value="Stretch"/>
                                        <Setter Property="Focusable"
                                                Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Border MaxWidth="{Binding ActualWidth, ElementName=ChatListBox, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.88}"
                                                    HorizontalAlignment="{Binding Converter={StaticResource ChatAlignmentConverter}}"
                                                    Background="{Binding Converter={StaticResource ChatBubbleBrushConverter}}"
                                                    BorderBrush="{Binding Converter={StaticResource ChatBorderBrushConverter}}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10,7">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Converter={StaticResource ChatBadgeConverter}}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextDimBrush}"
                                                               Margin="0,0,0,3"/>
                                                    <TextBox Text="{Binding Converter={StaticResource ChatTextConverter}, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             IsReadOnlyCaretVisible="False"
                                                             Background="Transparent"
                                                             Foreground="{StaticResource TextBrush}"
                                                             BorderThickness="0"
                                                             Padding="0"
                                                             FontSize="12"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Disabled"
                                                             HorizontalScrollBarVisibility="Disabled"
                                                             ContextMenu="{x:Null}"
                                                             ToolTip="Click and drag to select. Ctrl+C to copy."/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty-state overlay (only when ChatLog is empty) -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding ChatLog.Count, Converter={StaticResource ZeroCountToVisibilityConverter}, FallbackValue=Visible}">
                                <TextBlock Text="◈"
                                           FontSize="28"
                                           HorizontalAlignment="Center"
                                           Foreground="#55FFFFFF"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="No messages yet"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Text="Type below or speak to start a session — HCEP context is injected automatically."
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="260"
                                           Foreground="#7094A3B8"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Typing indicator (visible while SendCommand is running) -->
                        <Grid Grid.Row="5"
                              Margin="4,4,0,0"
                              Visibility="{Binding SendCommand.IsRunning, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="HCEP is thinking"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="TextBlock.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text"
                                                                                   Duration="0:0:1.2">
                                                        <DiscreteStringKeyFrame KeyTime="0:0:0"
                                                                                Value="."/>
                                                        <DiscreteStringKeyFrame KeyTime="0:0:0.3"
                                                                                Value=".."/>
                                                        <DiscreteStringKeyFrame KeyTime="0:0:0.6"
                                                                                Value="..."/>
                                                        <DiscreteStringKeyFrame KeyTime="0:0:0.9"
                                                                                Value=""/>
                                                    </StringAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Input row -->
                        <Grid Grid.Row="6"
                              Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="#20FFFFFF"
                                    CornerRadius="6"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1">
                                <TextBox x:Name="ChatInputTextBox"
                                         Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderThickness="0"
                                         Padding="8,6"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinLines="1"
                                         MaxLines="4"
                                         VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="ChatInput_PreviewKeyDown"
                                         ToolTip="Press Enter to send. Press Shift+Enter to insert a new line."/>
                            </Border>
                            <Button Grid.Column="1"
                                    Content="Send"
                                    Margin="6,0,0,0"
                                    Command="{Binding SendCommand}"
                                    Background="{StaticResource PrimaryBrush}"
                                    Foreground="White"
                                    ToolTip="Send the typed message to the LLM assistant with current HCEP context"
                                    BorderThickness="0"
                                    Padding="12,6"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8"
                Padding="12,6"
                Margin="12,8,12,4"
                ToolTip="Pipeline status bar — shows current status and copyright">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           ToolTip="Current pipeline status message"/>
                <TextBlock Grid.Column="1"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="16,0,0,0"
                           ToolTip="Kinect sensor tilt angle — use Kinect menu to adjust">
                    <Run Text="Tilt: "/>
                    <Run Text="{Binding ElevationAngle, Mode=OneWay, StringFormat={}{0}°}"/>
                </TextBlock>
                <TextBlock Grid.Column="3"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           ToolTip="Copyright notice">
                    <Run Text="© 2026 Kirk LaSalle"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
