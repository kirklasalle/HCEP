<Window x:Class="HCEP.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HCEP — Gaze Calibration"
        Background="#0A0A0A"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid>

        <!-- ── Crosshair Canvas (fills entire window) ─────────── -->
        <Canvas x:Name="CrosshairCanvas"
                Background="Transparent"
                ToolTip="Full-screen calibration overlay — crosshair marks the exact physical centre of this display">

            <!-- Horizontal line (drawn in code-behind once size is known) -->
            <Line x:Name="HLine"
                  Stroke="#33FFFFFF"
                  StrokeThickness="1"/>

            <!-- Vertical line -->
            <Line x:Name="VLine"
                  Stroke="#33FFFFFF"
                  StrokeThickness="1"/>

            <!-- Target outer ring -->
            <Ellipse x:Name="TargetRing"
                     Width="80"
                     Height="80"
                     Stroke="#FFFFFFFF"
                     StrokeThickness="1.5"
                     Fill="Transparent"/>

            <!-- Target inner ring -->
            <Ellipse x:Name="TargetInner"
                     Width="20"
                     Height="20"
                     Stroke="#FFFFFFFF"
                     StrokeThickness="1.5"
                     Fill="Transparent"/>

            <!-- Target centre dot -->
            <Ellipse x:Name="TargetDot"
                     Width="6"
                     Height="6"
                     Fill="#FFFFFFFF"/>

            <!-- Crosshair tick marks (short lines through the outer ring) -->
            <Line x:Name="TickTop"
                  Stroke="White"
                  StrokeThickness="1.5"/>
            <Line x:Name="TickBottom"
                  Stroke="White"
                  StrokeThickness="1.5"/>
            <Line x:Name="TickLeft"
                  Stroke="White"
                  StrokeThickness="1.5"/>
            <Line x:Name="TickRight"
                  Stroke="White"
                  StrokeThickness="1.5"/>

        </Canvas>

        <!-- ── Instructions (top centre) ─────────────────────── -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,60,0,0"
                    ToolTip="Calibration instructions — follow these steps to align the Kinect gaze model to this display">

            <TextBlock Text="HCEP GAZE CALIBRATION"
                       FontFamily="Segoe UI"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"/>

            <TextBlock Margin="0,12,0,0"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                Sit at your normal working distance.<LineBreak/>
                Focus your eyes on the centre crosshair, then press <Run Text="SPACE"
                                                                         FontWeight="Bold"
                                                                         Foreground="#FFFFD700"/> to capture.
            </TextBlock>

            <TextBlock Margin="0,10,0,0"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#88FFFFFF"
                       HorizontalAlignment="Center">
                Press  <Run Text="ESC"
                            FontWeight="Bold"/>  to cancel without saving.
            </TextBlock>

        </StackPanel>

        <!-- ── Live Face-Tracking Readout (bottom-left) ────────── -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="40,0,0,40"
                Padding="16,12"
                Background="#CC111111"
                CornerRadius="6"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                ToolTip="Live Kinect face-tracking data — confirms the Kinect is actively tracking your face before capture">

            <StackPanel>

                <TextBlock Text="LIVE FACE TRACKING"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#88FFFFFF"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Status"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               x:Name="TrackingStatusText"
                               Text="—"
                               Foreground="#FFFFFFFF"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Head X"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               x:Name="HeadXText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Head Y"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               x:Name="HeadYText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Head Z (depth)"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               x:Name="HeadZText"
                               Text="—"
                               Foreground="#FF64D8FF"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Pitch (°)"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               x:Name="PitchText"
                               Text="—"
                               Foreground="#FFFFD700"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Yaw (°)"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               x:Name="YawText"
                               Text="—"
                               Foreground="#FFFFD700"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                </Grid>

            </StackPanel>
        </Border>

        <!-- ── Computed Offset Preview (bottom-right) ───────────── -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,40,40"
                Padding="16,12"
                Background="#CC111111"
                CornerRadius="6"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                ToolTip="Computed KinectToScreenOriginOffset — preview of the calibration values that will be saved to the pipeline orchestrator on SPACE press">

            <StackPanel>

                <TextBlock Text="KINECT → SCREEN OFFSET (preview)"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#88FFFFFF"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="KinectOffsetX (mm)"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               x:Name="OffsetXText"
                               Text="—"
                               Foreground="#FF90EE90"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="KinectOffsetY (mm)"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               x:Name="OffsetYText"
                               Text="—"
                               Foreground="#FF90EE90"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="KinectOffsetZ (mm)"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               x:Name="OffsetZText"
                               Text="—"
                               Foreground="#FF90EE90"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Working dist (mm)"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Margin="0,2"/>
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               x:Name="WorkingDistText"
                               Text="—"
                               Foreground="#FFFFD700"
                               FontSize="12"
                               FontFamily="Segoe Mono,Consolas"
                               Margin="0,2"/>

                </Grid>

            </StackPanel>
        </Border>

        <!-- ── Status Bar (bottom centre) ──────────────────────── -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,40"
                Padding="20,8"
                Background="#CC111111"
                CornerRadius="20"
                ToolTip="Calibration status message">
            <TextBlock x:Name="StatusText"
                       Text="Waiting for face tracking…"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Foreground="#CCFFFFFF"/>
        </Border>

    </Grid>
</Window>
