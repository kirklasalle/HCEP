<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HCEP.App</RootNamespace>
    <AssemblyName>HCEP.App</AssemblyName>
    <UseWPF>true</UseWPF>
    <Description>HCEP WPF application - real-time Kinect multi-modal perception dashboard.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HCEP.Core\HCEP.Core.csproj" />
    <ProjectReference Include="..\HCEP.Kinect\HCEP.Kinect.csproj" />
    <ProjectReference Include="..\HCEP.Vision\HCEP.Vision.csproj" />
    <ProjectReference Include="..\HCEP.Audio\HCEP.Audio.csproj" />
    <ProjectReference Include="..\HCEP.Spatial\HCEP.Spatial.csproj" />
    <ProjectReference Include="..\HCEP.Intelligence\HCEP.Intelligence.csproj" />
    <ProjectReference Include="..\HCEP.Knowledge\HCEP.Knowledge.csproj" />
    <ProjectReference Include="..\HCEP.Telemetry\HCEP.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="models\arcface.onnx" CopyToOutputDirectory="PreserveNewest" Link="models\arcface.onnx" />
  </ItemGroup>
</Project>
