<Window x:Class="HCEP.App.SkeletalAlignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HCEP - Skeletal Alignment"
        Width="520"
        Height="450"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="CanResize"
        MinWidth="460"
        MinHeight="410"
        ToolTip="Live-adjust the skeleton overlay independently from the face mesh overlay.">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Skeletal Alignment"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextDimBrush}"
                   Margin="0,0,0,14"
                   Text="Watch the main window's sensor feed while dragging these controls. This adjusts only the green skeleton overlay; face mesh alignment remains controlled by the Face Mesh Alignment window."/>

        <Grid Grid.Row="2"
                Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Skeleton vertical (px)"
                       VerticalAlignment="Center"/>
            <Slider x:Name="VerticalSlider"
                    Grid.Column="1"
                    Minimum="-120"
                    Maximum="120"
                    TickFrequency="10"
                    IsSnapToTickEnabled="False"
                    Value="48"
                    ValueChanged="OnVerticalChanged"
                    ToolTip="Vertical shift applied only to skeleton joints and bones. Increase shifts down."/>
            <TextBlock x:Name="VerticalReadout"
                       Grid.Column="2"
                       Text="48.0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas"/>
        </Grid>

        <Grid Grid.Row="3"
                Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Skeleton horizontal (px)"
                       VerticalAlignment="Center"/>
            <Slider x:Name="HorizontalSlider"
                    Grid.Column="1"
                    Minimum="-100"
                    Maximum="100"
                    TickFrequency="5"
                    IsSnapToTickEnabled="False"
                    Value="0"
                    ValueChanged="OnHorizontalChanged"
                    ToolTip="Horizontal shift applied only to skeleton joints and bones. Increase shifts right."/>
            <TextBlock x:Name="HorizontalReadout"
                       Grid.Column="2"
                       Text="0.0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas"/>
        </Grid>

        <Grid Grid.Row="4"
                Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Skeleton scale"
                       VerticalAlignment="Center"/>
            <Slider x:Name="ScaleSlider"
                    Grid.Column="1"
                    Minimum="0.6"
                    Maximum="1.6"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="False"
                    Value="1.0"
                    ValueChanged="OnScaleChanged"
                    ToolTip="Uniform skeleton scale around the Kinect 640x480 image center."/>
            <TextBlock x:Name="ScaleReadout"
                       Grid.Column="2"
                       Text="1.00"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas"/>
        </Grid>

        <Border Grid.Row="5"
                Background="#22FFFFFF"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Alignment protocol"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="11"
                           Margin="0,3,0,0"
                           Text="1) Sit or stand in your normal working position. 2) Align shoulder and elbow joints first using X/Y. 3) Use scale only if the skeleton is consistently too wide or too narrow. 4) Save when the green bones match your body on the color feed."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <TextBlock x:Name="SaveStatus"
                       Foreground="{StaticResource PrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Button Content="Reset Defaults"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="ResetButton_Click"
                    ToolTip="Restore skeleton overlay defaults (Y = 48 px, X = 0 px, Scale = 1.0)."/>
            <Button Content="Save"
                    Padding="14,4"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    ToolTip="Persist the current skeleton alignment values."/>
            <Button Content="Close"
                    Padding="12,4"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>